{
  "schema": "solodesk.verification.suites",
  "schema_version": 1,
  "id": "F002-suites-v1",
  "checks": [
    {
      "id": "typecheck",
      "group": "baseline",
      "executable": "$NODE",
      "argv": [
        "node_modules/typescript/bin/tsc",
        "--noEmit"
      ],
      "kind": "command",
      "min_tests": 1,
      "timeout_ms": 300000,
      "phase_ids": [
        "F002"
      ],
      "requirement_ids": [
        "NFR-014"
      ],
      "scenario_ids": [
        "A-01"
      ],
      "entry_files": []
    },
    {
      "id": "lint",
      "group": "baseline",
      "executable": "$NODE",
      "argv": [
        "node_modules/oxlint/bin/oxlint",
        "--deny-warnings",
        "--threads",
        "2",
        "app",
        "tooling",
        "tests/verification",
        "vite.config.mts",
        "vite.main.config.mts",
        "forge.config.mjs"
      ],
      "kind": "command",
      "min_tests": 1,
      "timeout_ms": 300000,
      "phase_ids": [
        "F002"
      ],
      "requirement_ids": [
        "NFR-014"
      ],
      "scenario_ids": [
        "A-01"
      ],
      "entry_files": []
    },
    {
      "id": "build",
      "group": "baseline",
      "executable": "$NODE",
      "argv": [
        "node_modules/vite/bin/vite.js",
        "build",
        "--config",
        "vite.main.config.mts"
      ],
      "kind": "command",
      "min_tests": 1,
      "timeout_ms": 300000,
      "phase_ids": [
        "F002"
      ],
      "requirement_ids": [
        "NFR-014"
      ],
      "scenario_ids": [
        "A-01"
      ],
      "entry_files": []
    },
    {
      "id": "build-renderer",
      "group": "baseline",
      "executable": "$NODE",
      "argv": [
        "node_modules/vite/bin/vite.js",
        "build"
