      "kind": "tests",
      "min_tests": 9,
      "timeout_ms": 300000,
      "phase_ids": [
        "F002"
      ],
      "requirement_ids": [
        "NFR-014"
      ],
      "scenario_ids": [
        "A-01"
      ],
      "entry_files": [
        "tests/verification/integration/context.test.mjs",
        "tests/verification/integration/setup.test.mjs",
        "tests/verification/integration/runner.test.mjs"
