{
  "name": "solodesk",
  "version": "0.0.0",
  "private": true,
  "description": "SoloDesk desktop workspace — minimal runnable shell",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "node tooling/start.mjs",
    "build": "vite build --config vite.main.config.mts && vite build --config vite.preload.config.mts && vite build",
    "typecheck": "tsc --noEmit",
    "test:launcher": "node --test --test-isolation=none tooling/start.test.mjs",
    "ui:info": "node tooling/ui-info.mjs",
    "setup:electron": "install-electron",
    "lint": "oxlint --deny-warnings --threads 2 app tooling tests/verification tests/f004 vite.config.mts vite.main.config.mts vite.preload.config.mts forge.config.mjs",
    "test:unit": "node tooling/verification/run-suite.mjs verification-unit",
    "test:integration": "node tooling/verification/run-suite.mjs verification-integration",
    "check:docs": "node tooling/verification/documentation.mjs",
    "verify": "node tooling/verification/cli.mjs verify",
    "test:desktop": "node tooling/verification/desktop.mjs",
    "check:security": "node tooling/verification/cli.mjs run --group security",
    "setup:f003": "node tooling/f003/setup-runtime.mjs",
    "test:f003": "node tooling/f003/verify.mjs",
    "test:f003:unit": "node tooling/f003/verify.mjs F003:unit",
    "test:f003:adapters": "node tooling/f003/verify.mjs F003:adapters",
    "test:f003:errors": "node tooling/f003/verify.mjs F003:errors",
    "test:f003:source-quality": "node tooling/f003/verify.mjs F003:source-quality",
    "test:f003:runtime": "node tooling/f003/verify.mjs F003:runtime",
    "test:f004": "node tooling/f004/verify.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@playwright/test": "^1.64.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/rebuild": "4.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.8.0",
    "oxlint": "1.88.0",
    "spdx-expression-parse": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "packageManager": "npm@11.19.0"
}
