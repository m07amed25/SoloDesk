{
  "name": "solodesk",
  "version": "0.0.0",
  "private": true,
  "description": "SoloDesk desktop workspace — minimal runnable shell",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "node tooling/start.mjs",
    "build": "vite build --config vite.main.config.mts && vite build --config vite.preload.config.mts && vite build",
    "db:migrate": "node tooling/f010/database.mjs deploy",
    "typecheck": "tsc --noEmit",
